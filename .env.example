# Copy this file to .env to change the defaults. Everything here is optional.

# Port on the server that the app is published on.
APP_PORT=4747

# Which address it's published on. 0.0.0.0 = every network interface (default).
# 127.0.0.1 = this machine only, when a web server or tunnel on the same machine sits in front.
APP_BIND=0.0.0.0

# 1 when a web server or tunnel sits in front of the app (default).
# 0 when visitors connect to APP_PORT directly, so a visitor can't fake their IP to get around the login limits.
TRUST_PROXY=1
