# Copy this file to .env to change the defaults. Everything here is optional.

# Port on the server that the app is published on.
APP_PORT=4747

# Which address it's published on. 127.0.0.1 = only this machine, for a web server or tunnel in front (recommended).
# 0.0.0.0 = open to the network directly (no HTTPS). If you use 0.0.0.0, also set TRUST_PROXY=0.
APP_BIND=127.0.0.1

# 1 when a web server or tunnel sits in front of the app, 0 when visitors connect to it directly.
TRUST_PROXY=1
